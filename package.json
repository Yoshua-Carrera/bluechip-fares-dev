{
  "name": "bluechipfares-redesign",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --host 0.0.0.0 --port 3000\"",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "pretty": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "check-types": "tsc --noEmit",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "precommit": "pnpm pretty && pnpm build && pnpm check-types",
    "db:generate-auth": "auth generate --output ./db/auth-schema.ts",
    "db:generate": "pnpm db:generate-auth && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.0-rc.2",
    "@faker-js/faker": "^10.3.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@neondatabase/serverless": "^1.0.2",
    "@posthog/react": "^1.7.0",
    "@sentry/tanstackstart-react": "^10.67.0",
    "@strapi/client": "^1.6.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/store": "latest",
    "better-auth": "1.7.0-rc.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "^0.577.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.16.3",
    "posthog-js": "^1.358.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "relations-v2": "link:@better-auth/drizzle-adapter/relations-v2",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "use-debounce": "^10.1.0",
    "vite-plugin-neon-new": "^0.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@inlang/paraglide-js": "^2.13.1",
    "@netlify/vite-plugin-tanstack-start": "^1.2.15",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/tanstack-react": "^10.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "auth": "1.7.0-rc.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.20.0",
    "eslint-plugin-storybook": "^10.5.10",
    "husky": "^9.1.7",
    "playwright": "latest",
    "prettier": "^3.8.1",
    "storybook": "^10.5.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "@sentry/cli"
    ]
  }
}
